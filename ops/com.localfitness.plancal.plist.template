<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Evening "fitness plan-calendar" job for macOS launchd.

  TEMPLATE — `ops/install-launchd.sh` fills in __UV_BIN__ and __REPO_ROOT__
  with absolute paths resolved on the install host. Nothing host-specific is
  committed.

  The job runs `fitness plan-calendar`, which makes Google Calendar equal the
  ACTIVE training plan: every prescribed session from today through the plan's
  last day as an all-day event, updated where it drifted, and DELETED where the
  plan no longer asks for it. A rest day (or no active plan) writes nothing and
  exits 0.

  Since 0.53.0 the four plan-write MCP tools sync themselves, so this job is a
  RECONCILER rather than the only writer — it repairs a sync that failed
  mid-edit, a plan changed through `run_sql`, or a day that drifted.

  Credentials, all from <repo>/.env via the CLI's load_dotenv():
    * LOCAL_FITNESS_GCAL_CLIENT_ID / _CLIENT_SECRET — the OAuth client
    * LOCAL_FITNESS_GCAL_REFRESH_TOKEN — from `uv run fitness calendar-auth`
  See docs/google-calendar.md for the one-time Google Cloud setup.

  Unlike the two brief jobs this one needs NO Claude credential and makes no
  Garmin call — it is a SQLite read plus one HTTPS request. It is still a
  LaunchAgent rather than a daemon, because it shares the repo's `.env` and
  logs directory and there is no reason to give it a wider security context
  than the jobs beside it.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.localfitness.plancal</string>

    <key>ProgramArguments</key>
    <array>
        <string>__UV_BIN__</string>
        <string>run</string>
        <string>--directory</string>
        <string>__REPO_ROOT__</string>
        <string>fitness</string>
        <string>plan-calendar</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_ROOT__</string>

    <!-- 19:05 with a 20:05 backstop — the brief email's cadence, offset five
         minutes so the two evening jobs don't contend for the same wake.
         Nothing here depends on the email having run.

         There is NO dedupe flag, and that is deliberate. The brief jobs each
         need one (`--if-missing` keys on the saved brief, `--if-unsent` on a
         per-date sent marker) because sending mail twice is not reversible.
         Here the whole run is a reconcile against ids hashed from
         (plan, date, seq): the backstop lists what is there, finds it already
         equal to the plan, and issues zero writes. Idempotence is a property of
         the data instead of a marker file that can drift from it — and it
         covers a wake-coalesced pileup and a manual re-run for free.

         It also handles the case a marker file could not: if the plan CHANGED
         between 19:05 and 20:05, the backstop applies the change rather than
         skipping it as already-done. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>19</integer>
            <key>Minute</key>
            <integer>5</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>20</integer>
            <key>Minute</key>
            <integer>5</integer>
        </dict>
    </array>

    <!-- Don't fire on install/load; wait for the scheduled hour. -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__REPO_ROOT__/logs/plancal.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO_ROOT__/logs/plancal.launchd.err.log</string>
</dict>
</plist>
